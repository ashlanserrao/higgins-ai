// Lint only (npm run lint). Biome parses TypeScript itself, so it works with TypeScript 7,
// which has no JS compiler API for typescript-eslint. The formatter stays off: no reformatting.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    // how-it-works/kit is vendored and demo/ is built, so neither is ours to lint.
    "includes": [
      "src/**", "e2e/**", "scripts/**", "how-it-works/**", "*.ts",
      "!src/lib/api/generated.ts", "!how-it-works/kit", "!how-it-works/demo"
    ]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // House style. tsc's verbatimModuleSyntax already requires `import type` where it matters.
        "useImportType": "off",
        // Used where the value is known to exist, e.g. the #root element in index.html.
        "noNonNullAssertion": "off",
        // Stylesheet order follows the page's sections, not selector specificity.
        "noDescendingSpecificity": "off"
      },
      "a11y": {
        // Hash-route links keep a real href (open in a new tab works) and handle the click in place.
        "useValidAnchor": "off",
        // Segmented toggles and card radio groups use ARIA roles on purpose (Lighthouse accessibility: 100).
        "useSemanticElements": "off"
      },
      "complexity": {
        // Print styles must win over Tailwind's utilities.
        "noImportantStyles": "off"
      }
    }
  },
  "overrides": [
    {
      // Index keys where items have no id of their own and never reorder: iso tiles, digit
      // wheels, print-table cells, budget moves (the same move can repeat) and recent changes
      // (counted from the oldest, so each keeps its key as new ones arrive).
      "includes": [
        "src/features/landing/iso-scenes.tsx", "src/features/overview/odometer.tsx", "src/features/print/print-sheet.tsx",
        "src/features/budget/budget-section.tsx", "src/features/overview/next-step-panel.tsx"
      ],
      "linter": { "rules": { "suspicious": { "noArrayIndexKey": "off" } } }
    },
    {
      // Row receives its cells as a positional array and keys them itself.
      "includes": ["src/features/print/print-sheet.tsx"],
      "linter": { "rules": { "correctness": { "useJsxKeyInIterable": "off" } } }
    },
    // Layers: imports only point down, pages → features → components → state → hooks → lib
    // (docs/architecture.md). Code two layers share lives below both.
    // "../" is banned in src/ so a relative path can't step around the layer patterns: outside
    // its own folder, a file imports through "@/". Each layer repeats that pattern because an
    // override's options replace the earlier ones rather than adding to them.
    {
      "includes": ["src/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": { "level": "error", "options": { "patterns": [
        { "group": ["../**"], "message": "Import from outside this folder through \"@/\"." }
      ] } } } } }
    },
    {
      "includes": ["src/lib/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": { "level": "error", "options": { "patterns": [
        { "group": ["../**"], "message": "Import from outside this folder through \"@/\"." },
        { "group": ["@/hooks/**", "@/state/**", "@/components/**", "@/features/**", "@/pages/**", "@/App"],
          "message": "lib/ is the bottom layer: it imports nothing from the app above it." }
      ] } } } } }
    },
    {
      "includes": ["src/hooks/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": { "level": "error", "options": { "patterns": [
        { "group": ["../**"], "message": "Import from outside this folder through \"@/\"." },
        { "group": ["@/state/**", "@/components/**", "@/features/**", "@/pages/**", "@/App"],
          "message": "hooks/ holds generic hooks: they may use lib/, nothing above it." }
      ] } } } } }
    },
    {
      "includes": ["src/state/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": { "level": "error", "options": { "patterns": [
        { "group": ["../**"], "message": "Import from outside this folder through \"@/\"." },
        { "group": ["@/components/**", "@/features/**", "@/pages/**", "@/App"],
          "message": "state/ sits below the UI: it may use hooks/ and lib/, never components or features." }
      ] } } } } }
    },
    {
      "includes": ["src/components/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": { "level": "error", "options": { "patterns": [
        { "group": ["../**"], "message": "Import from outside this folder through \"@/\"." },
        { "group": ["@/features/**", "@/pages/**", "@/App"],
          "message": "Shared components are used by features, so they can't import from a feature." }
      ] } } } } }
    },
    {
      "includes": ["src/features/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": { "level": "error", "options": { "patterns": [
        { "group": ["../**"], "message": "Import from outside this folder through \"@/\"." },
        { "group": ["@/pages/**", "@/App"], "message": "Features are placed by pages, so they can't import a page." }
      ] } } } } }
    },
    {
      // Compact one-line stubs in tests.
      "includes": ["**/*.test.ts"],
      "linter": { "rules": { "complexity": { "noCommaOperator": "off" } } }
    }
  ]
}
