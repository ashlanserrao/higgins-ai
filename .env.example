# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Optional: without a key the app still returns the full rules-based plan, minus AI ideas.
OPENAI_API_KEY=

# Cheapest current OpenAI model with Structured Outputs (checked 2026-10-21).
OPENAI_MODEL=gpt-5-nano
# For reasoning models (gpt-5-*): keeps responses fast. Leave empty for e.g. gpt-4o-mini.
OPENAI_REASONING_EFFORT=minimal
AI_TIMEOUT_SECONDS=15

RATE_LIMIT_PER_MINUTE=20
