# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Optional: without any key the app still returns the full rules-based plan, minus the AI parts.
# With both keys, Groq answers first and OpenAI is the backup. With one key, that provider alone.
OPENAI_API_KEY=
GROQ_API_KEY=

# Cheapest current OpenAI model with Structured Outputs (checked 2026-10-21).
OPENAI_MODEL=gpt-5-nano
# For reasoning models (gpt-5-*): keeps responses fast. Leave empty for e.g. gpt-4o-mini.
OPENAI_REASONING_EFFORT=minimal

# A Groq model with strict JSON schema support (checked 2026-10-30).
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
# Groq's share of the time budget, so a slow reply still leaves OpenAI time to answer.
GROQ_TIMEOUT_SECONDS=5
# Optional model for one task: GROQ_MODEL_IDEAS, GROQ_MODEL_QUOTES, GROQ_MODEL_UNDERSTAND.
# GROQ_MODEL_IDEAS=openai/gpt-oss-120b

# The whole time one AI call may take, backup included.
AI_TIMEOUT_SECONDS=15

# Per IP per minute: AI idea requests, and rules-only plan requests (what-if sliders).
RATE_LIMIT_PER_MINUTE=20
PLAN_RATE_LIMIT_PER_MINUTE=120
# AI requests per hour from all visitors together, a cap on spend.
AI_TOTAL_LIMIT_PER_HOUR=200
